FROM postgres:16-alpine

# Criar usuário não privilegiado
RUN addgroup -g 1001 postgres-app && \
    adduser -D -u 1001 -G postgres-app postgres-app

# Definir variáveis de ambiente do PostgreSQL
ENV POSTGRES_DB=motoflow-db
ENV POSTGRES_USER=motoflow
ENV POSTGRES_PASSWORD=motoflow

# Criar diretórios necessários com permissões adequadas
RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres-app:postgres-app /var/lib/postgresql && \
    chmod 700 /var/lib/postgresql/data

# Mudar para usuário não privilegiado
USER postgres-app

EXPOSE 5432